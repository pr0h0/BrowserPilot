{
  "name": "browserpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:backend": "bun --filter @browserpilot/backend dev",
    "dev:extension": "bun --filter @browserpilot/extension dev",
    "dev:cli": "bun --filter @browserpilot/cli dev",
    "build": "bun --filter '*' build",
    "test": "bun test packages apps",
    "typecheck": "bun --filter '*' typecheck",
    "db:generate": "bun --filter @browserpilot/backend db:generate",
    "db:migrate": "bun --filter @browserpilot/backend db:migrate",
    "cli": "bun apps/cli/src/index.ts"
  },
  "engines": { "bun": ">=1.3" },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}
