{
  "name": "@browserpilot/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "echo 'backend: run with bun, no build step'",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@browserpilot/protocol": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3"
  }
}
