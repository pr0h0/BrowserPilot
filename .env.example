NODE_ENV=development
# HOST=127.0.0.1 by default — the REST API can drive your browser; only widen this deliberately.
PORT=9876
DATABASE_URL=file:./data/browserpilot.sqlite
# Required outside development. Also sent by the CLI (BROWSERPILOT_TOKEN/PAIRING_TOKEN)
# and by the extension as Authorization: Bearer on REST calls.
PAIRING_TOKEN=
SCREENSHOT_DIR=./data/screenshots

# --- AI provider ---
# AI_PROVIDER: openai | deepseek | openrouter | anthropic
# openai/deepseek/openrouter all speak the OpenAI chat-completions API — just change
# OPENAI_BASE_URL + OPENAI_MODEL. anthropic uses its native messages API.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Provider presets (copy the block you want over the three vars above):
#  DeepSeek    : AI_PROVIDER=deepseek   OPENAI_BASE_URL=https://api.deepseek.com   OPENAI_MODEL=deepseek-chat
#  OpenRouter  : AI_PROVIDER=openrouter OPENAI_BASE_URL=https://openrouter.ai/api/v1 OPENAI_MODEL=openai/gpt-4o-mini
#  Anthropic   : AI_PROVIDER=anthropic  OPENAI_API_KEY=<anthropic key>  OPENAI_MODEL=claude-3-5-sonnet-latest
#  Local (LM Studio/Ollama): AI_PROVIDER=openai OPENAI_BASE_URL=http://localhost:1234/v1 OPENAI_API_KEY=local
